# Copy to .env.local to override the values in .env on your own computer.
# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Which sign-in buttons to show: any of google, apple, email
NEXT_PUBLIC_AUTH_PROVIDERS=email

# Optional: set to 1 to enable /preview/dashboard etc. with sample data.
# Leave unset in production.
# NEXT_PUBLIC_DEMO_MODE=1
