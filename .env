# Public connection details for this app's Supabase project.
# These are safe to commit: the publishable key is designed to be used in the
# browser, and Row Level Security protects every row. No secret key is needed.
# To use a different Supabase project, change these two values.
NEXT_PUBLIC_SUPABASE_URL=https://rhjmsbofqwtvmzlktuxo.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_28-2HuEweT0VeeP2qAzgHQ_jxOdIGa-

# Sign-in methods shown on the login page. Email works out of the box.
# After setting up Google/Apple in Supabase (see README), change to e.g.
# NEXT_PUBLIC_AUTH_PROVIDERS=google,apple,email
NEXT_PUBLIC_AUTH_PROVIDERS=google
